{
  "name": "progresso",
  "version": "2.0.0",
  "description": "A progress tracking and calendar app",
  "desktopName": "Progresso",
  "main": "main.js",
  "homepage": "https://progressoelectron.com",
  "scripts": {
    "start": "electron .",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb",
    "dist:rpm": "electron-builder --linux rpm",
    "dist:arch": "electron-builder --linux pacman"
  },
  "author": "Abel M Punnoose <abel.punnoose.cosmic@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.2.0"
  },
  "build": {
    "appId": "com.cosmic.progresso",
    "productName": "Progresso",
   "linux": {
      "category": "Utility",
      "icon": "assets/icons/icon256.png",
      "maintainer": "Abel M Punnoose <abel.punnoose.cosmic@gmail.com>",
      "synopsis": "Progress tracking and calendar application",
      "description": "Progresso is a progress tracking and calendar application.",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    } 
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zeta-Chrome/progresso.git"
  },
  "bugs": {
    "url": "https://github.com/Zeta-Chrome/progresso/issues"
  }
}
